------------------------------------------------------------
-- MY BINDS
------------------------------------------------------------

hl.bind(
    mainMod .. " + Return",
    hl.dsp.exec_cmd(terminal)
)

hl.bind(
    "SUPER + CTRL + A",
    hl.dsp.exec_cmd("~/.local/bin/default_audio.sh")
)

hl.bind(
    "SUPER + CTRL + B",
    hl.dsp.exec_cmd(browser)
)

hl.bind(
    "SUPER + CTRL + C",
    hl.dsp.exec_cmd("~/.local/bin/conky.sh")
)

hl.bind(
    "SUPER + CTRL + E",
    hl.dsp.exec_cmd("~/.local/bin/rofi-beats")
)

hl.bind(
    "SUPER + CTRL + F",
    hl.dsp.exec_cmd(fileManager)
)

hl.bind(
    "SUPER + CTRL + G",
    hl.dsp.exec_cmd("lutris lutris:rungameid/1")
)

hl.bind(
    "SUPER + CTRL + H",
    hl.dsp.exec_cmd("~/.local/bin/monitor-external")
)

hl.bind(
    "SUPER + CTRL + L",
    hl.dsp.exec_cmd("~/.local/bin/monitor-internal")
)

hl.bind(
    "SUPER + CTRL + N",
    hl.dsp.exec_cmd(
        "qs -c noctalia --daemon ipc call settings toggle")
)

hl.bind(
    "SUPER + SHIFT + N",
    hl.dsp.exec_cmd(
        "~/.local/bin/rofi-wifi-menu.sh")
)

hl.bind(
    "SUPER + SHIFT + R",
    hl.dsp.exec_cmd(
        "~/.local/bin/hypr-reload.sh")
)

hl.bind(
    "SUPER + CTRL + S",
    hl.dsp.exec_cmd("steam")
)

hl.bind(
    "SUPER + CTRL + Q",
    hl.dsp.exec_cmd("qs -c noctalia --daemon")
)

hl.bind(
    "SUPER + CTRL + T",
    hl.dsp.exec_cmd(terminal .. " -e tmux")
)

hl.bind(
    "SUPER + SHIFT + V",
    hl.dsp.exec_cmd(
        "~/.local/bin/rofi-vpn.sh")
)

hl.bind(
    "SUPER + CTRL + V",
    hl.dsp.exec_cmd(terminal .. " -e " .. editor)
)

hl.bind(
    "SUPER + CTRL + W",
    hl.dsp.exec_cmd(
        "~/.local/bin/workspaces.sh")
)

hl.bind(
    "SUPER + CTRL + X",
    hl.dsp.exec_cmd("hyprlock")
)

hl.bind(
    "SUPER + PRINT",
    hl.dsp.exec_cmd('grim -g "$(slurp)" - | wl-copy')
)

hl.bind(
    "PRINT",
    hl.dsp.exec_cmd("grim ~/screenshot-$(date +%Y%m%d-%H%M%S).png")
)
------------------------------------------------------------
-- AUDIO
------------------------------------------------------------

hl.bind(
    "F2",
    hl.dsp.exec_cmd("pamixer -i 10")
)

hl.bind(
    "F3",
    hl.dsp.exec_cmd("pamixer -d 10")
)

hl.bind(
    "F4",
    hl.dsp.exec_cmd("pamixer -t")
)


------------------------------------------------------------
-- NOCTALIA
------------------------------------------------------------

hl.bind("SUPER + D", hl.dsp.exec_cmd("noctalia msg panel-toggle launcher"))

hl.bind("SUPER + SHIFT + E", hl.dsp.exec_cmd("noctalia msg panel-toggle session"))

