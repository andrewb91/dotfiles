# OLLAMA

# Service management

super + ctrl + m; s
    systemctl --user start ollama

super + ctrl + m; x
    systemctl --user stop ollama

super + ctrl + m; r
    systemctl --user restart ollama

# Model management

super + ctrl + m; 4
    ghostty -e ollama run qwen3:4b

super + ctrl + m; 8
    ghostty -e ollama run qwen3:8b

super + ctrl + m; 9
    ghostty -e ollama run qwen3.5:9b

