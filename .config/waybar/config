// ### DUAL TOP and BOTTOM ### //

[{
"include": [
  "$HOME/.config/waybar/Modules",
  ],
"layer": "top",
//"mode": "dock",
"exclusive": true,
"passthrough": false,
"position": "top",
"spacing": 3,
"fixed-center": true,
"ipc": true,
"margin-top": 1,
"margin-left": 8,
"margin-right": 10,

"modules-left": [
	"cpu", 
	"power-profiles-daemon",
	"temperature",
	"memory",
	"disk#boot",
	"custom/separator#blank",
	"disk",
	"custom/separator#blank",
	"disk#home",
	"custom/separator#blank",
	"disk#files",
	"custom/separator#blank",
	],

"modules-right": [
	"idle_inhibitor",
	"custom/separator#blank",
   "group/notify",
	"battery", 
	"backlight",
	"bluetooth",
	"network",
	"wireplumber", 
	"pulseaudio#microphone",
	"custom/separator#blank",
	"custom/weather",
	"custom/separator#blank",
	"clock",
	],
}],
