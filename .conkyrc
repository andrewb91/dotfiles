--[[
#*     *     *     *     *     *
#          arcolinux
# Date    : package-date
# Author  : Erik Dubois at http://www.erikdubois.be
# Version : package-version
# License : Distributed under the terms of GNU GPL version 2 or later
# Documentation : http://erikdubois.be/
#*     *     *     *     *     *
# CONKY
# For commands in conky.config section:
# http://conky.sourceforge.net/config_settings.html
#
# For commands in conky.text section:
# http://conky.sourceforge.net/variables.html
#
# A PDF with all variables is provided
#*     *     *     *     *     *
# FONTS
# To avoid copyright infringements you will have to download
# and install the fonts yourself sometimes.
#*     *     *     *     *     *
# GENERAL INFO ABOUT FONTS
# Go and look for a nice font on sites like http://www.dafont.com/
# Download and unzip - double click the font to install it (font-manager must be installed)
# No font-manager then put fonts in ~/.fonts
# Change the font name in the conky
# The name can be known with a command in the terminal: fc-list | grep "part of name"
# Change width and height of the conky according to font
# Reboot your system or fc-cache -fv in terminal
# Enjoy
#*     *     *     *     *     *
# FONTS FOR THIS CONKY
# http://www.dafont.com/style-bats.font
#*     *     *     *     *     *
# Titus Modifications
#*     *     *     *     *     *
# Changed time from Roboto to GE Inspira which is a base Conky Gotham Addon
# Changed Drives from 2 to 3
# Modified one_window_type from desktop to normal for KDE compatibility
# Modified Ethernet settings
# Modified Pink Lines to Bright Blue
# Removed Extra symbols and incorrect formatting
#*     *     *     *     *     *

]]

conky.config = {

	--Various settings

	background = true,
	cpu_avg_samples = 2,
	diskio_avg_samples = 10,
	double_buffer = true,
	if_up_strictness = 'address',
	net_avg_samples = 2,
	no_buffers = true,
	temperature_unit = 'fahrenheit',
	text_buffer_size = 2048,
	update_interval = 1,
	imlib_cache_size = 0,
	out_to_wayland = true,

	--Placement

	alignment = 'top_left',
	--Arch Duoscreen
	--gap_x = -1910,
	gap_x = 15,
	gap_y = 15,
	minimum_height = 600,
	minimum_width = 50,
	maximum_width = 250,

	--Graphical

	border_inner_margin = 10, 
	border_outer_margin = 5, 
	border_width = 0,
	default_bar_width = 60,
	default_bar_height = 10,
	default_gauge_height = 25,
	default_gauge_width =40,
	default_graph_height = 40,
	default_graph_width = 0,
	default_outline_color = '#000000',
	default_shade_color = '#000000',
	draw_borders = false,
	draw_graph_borders = true,
	draw_shades = false,
	draw_outline = false,
	stippled_borders = 0,

	--Textual

	extra_newline = false,	
	format_human_readable = true,
	font = 'Roboto:Bold:size=10',
	max_text_width = 0,
	max_user_text = 16384,
	override_utf8_locale = true,
	short_units = true,
	top_name_width = 21,
	top_name_verbose = false,
	uppercase = false,
	use_spacer = 'none',
	use_xft = true,
	xftalpha = 1,

	--Windows

	own_window = true,
	own_window_class = Conky,
	own_window_argb_value = 100,
	own_window_argb_visual = true,
	own_window_colour = '#000000',
	own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
	own_window_transparent = false,
	own_window_title = 'system_conky',
	own_window_type = 'override',

	--Colours

--	default_color = '#bfc5c6',
	default_color = '#FFFFFF',
	color1 = '#FF0000',
	color2 = '#597AA1',
	color3 = '#cccccc',
	color4 = '#D9BC83',
	color6 = '#d3d3d3',	
	color6 = '#1F7411',

	--Signal Colours
	color7 = '#1F7411',  						--green
	color8 = '#FFA726',  						--orange
	color9 = '#F1544B',  						--firebrick

    --Lua

};

conky.text = [[
${alignc}${voffset 4}${font GE Inspira:Bold:size=64}${alignc}${time %H}:${time %M}${font}
#${time %p}
${alignc}${voffset 4}${font GE Inspira:Bold:size=20}${alignc}${time %a} ${time %b} ${time %e}, ${time %Y}${font}
#color6 = '#3b78c2',

${offset 5}${font Roboto:Bold:size=14}${voffset 2}S Y S T E M   ${hr 2}${font}
${offset 5}${voffset 8}Hostname: ${alignr}${nodename}
${offset 5}Distro:${alignr}Arch Linux ${alignr}
#${execi 6000 lsb_release -a | grep 'Description'|awk {'print $3, $4, $5'}}
${offset 5}Kernel:${alignr}${exec uname} ${exec uname -r}
${offset 5}Uptime: ${alignr}${uptime}

${offset 5}${font Roboto:Bold:size=14}P R O C E S S O R S  ${hr 2}${font}
${offset 5}CPU Freq: $alignr${freq}MHz
${offset 5}CPU Core 1: ${alignr}${offset -10}${cpu cpu1}%${alignr}${cpubar cpu1}
${offset 5}CPU Core 2: ${alignr}${offset -10}${cpu cpu2}%${alignr}${cpubar cpu2}
${offset 5}CPU Core 3: ${alignr}${offset -10}${cpu cpu3}%${alignr}${cpubar cpu3}
${offset 5}CPU Core 4: ${alignr}${offset -10}${cpu cpu4}%${alignr}${cpubar cpu4}
${offset 5}CPU Core 5: ${alignr}${offset -10}${cpu cpu5}%${alignr}${cpubar cpu5}
${offset 5}CPU Core 6: ${alignr}${offset -10}${cpu cpu6}%${alignr}${cpubar cpu6}

${offset 5}${font Roboto:Bold:size=14}M E M O R Y   ${hr 2}${font}
${offset 5}RAM: ${alignr}${offset -10}${MEM} / ${memmax}${alignr}${membar}
${offset 5}Swap: ${alignr}${offset -10}${swap} / ${swapmax}${alignr}${swapbar} 

${offset 5}${font Roboto:Bold:size=14}D R I V E S   ${hr 2}${font}
${offset 5}/boot   ${alignr}${offset -10}${fs_used /boot} / ${fs_free /boot}${alignr}${fs_bar /boot}
${offset 5}/   ${alignr}${offset -10}${fs_used /} / ${fs_free /}${alignr}${fs_bar /}
${offset 5}/home   ${alignr}${offset -10}${fs_used /home} / ${fs_free /home}${alignr}${fs_bar /home}
#${offset 5}/var   ${alignr}${offset -10}${fs_used /var} / ${fs_free /var}${alignr}${fs_bar /var}
${offset 5}/Files   ${alignr}${offset -10}${fs_used /Files} / ${fs_free /Files}${alignr}${fs_bar /Files}

${offset 5}${font Roboto:Bold:size=14}N E T W O R K   ${hr 2}${font}
${offset 5}IP:  ${execi 10 ${HOME}/.local/bin/myip}
${offset 5}LAN:  ${alignr}${offset -10$}${addrs wlan0}
${offset 5}Wifi Up: ${alignr}${offset -10$}${upspeed wlan0}${alignr}${upspeedgraph  wlan0 8,100}
${offset 5}Wifi Down: ${alignr}${offset -10$}${downspeed wlan0}${alignr}${downspeedgraph wlan0 8,100}
]]
