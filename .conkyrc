conky.config = {
--==============================================================================
-- 2017/10/25
-- this is for conky version 1.1
-- converted by me using lua convert tool
-- 
--                               Conky_Rings

--  author  : SLK
--  version : v2011011601
--  license : Distributed under the terms of GNU GPL version 2 or later
--  modified: me
--  version : v20171027
--  notes   : works on 4k screen. uses conky conf newer >v1.1

--==============================================================================

	background = true,
	update_interval = 1,

	cpu_avg_samples = 2,
	net_avg_samples = 2,
	temperature_unit = 'fahrenheit',

	double_buffer = true,
	no_buffers = true,
	text_buffer_size = 2048,

	gap_x = 20,
	gap_y = 20,
	minimum_width = 350, minimum_height = 900,
	maximum_width = 350,
        own_window = true,
--## me change, added next 2 lines
--## own_window_type override
	own_window_type = 'dock',
 	own_window_class = 'Conky',
-- 	own_window_colour = 'clear',
   own_window_argb_visual = true,
	own_window_argb_value = 30,
	own_window_transparent = true,
   own_window_hints = 'undecorated,sticky,skip_taskbar,skip_pager',
	border_inner_margin = 0,
	border_outer_margin = 0,
	alignment = 'top_left',

	draw_shades = true,
	draw_outline = false,
	draw_borders = false,
	draw_graph_borders = false,

	override_utf8_locale = true,
	use_xft = true,
	font = 'Ubuntu:size=8',
	xftalpha = 0.5,
	uppercase = false,

	default_color = '#FFFFFF',
	color1 = '#DDDDDD',
	color2 = '#AAAAAA',
	color3 = '#888888',
	color4 = '#EF5A29',
	
	lua_load = '/home/drew/.config/conky/Rings.lua',
	lua_draw_hook_post = 'main',
	lua_load = '~/.config/conky/center.lua'
   lua_startup_hook = 'conky_set_position'

};
conky.text = [[
${voffset 114}
${alignc}${font ubuntu:bold:size=18}${time %D} 
${alignc}${time %A}
 
${voffset 40}${font Ubuntu:bold:size=12}
${offset 10}Distro: $alignr Arch Linux  
${offset 10}Kernel:$alignr${kernel}  
${offset 10}Hostname:$alignr${nodename}  
${offset 10}Uptime:$alignr$uptime  
${voffset 5}${font Ubuntu:bold:size=10}
${alignc}${font Ubuntu:bold:size=12}CPU${font Ubuntu:bold:size=10}
${voffset 16}
${goto 60}${cpu cpu0}%  ${goto 175}${cpu cpu1}%  ${goto 290}${cpu cpu2}%
${voffset 8}
${goto 60}${cpu cpu3}%  ${goto 175}${cpu cpu4}%  ${goto 290}${cpu cpu5}%
${voffset 31}
${alignc}${font Ubuntu:bold:size=12}MEMORY${font Ubuntu:bold:size=10}
${voffset 13}
${goto 110}$memperc%  ${goto 240}$swapperc%
${voffset 16}
${alignc}${font Ubuntu:bold:size=12}HDD${font Ubuntu:bold:size=10}
${voffset 12}
${goto 60}${fs_used_perc /boot}%  ${goto 175}${fs_used_perc /}%  ${goto 290}${fs_used_perc /var}%
${voffset 8}
${goto 110}${fs_used_perc /home}%  ${goto 240}${fs_used_perc /Files}%
${voffset 35}
${alignc}${font Ubuntu:bold:size=12}NETWORK ${font Ubuntu:bold:size=10}
${offset 15}${if_up wlan0}LAN: ${addr wlan0}
${offset 15}${if_up wlan0}IP:    ${execi 10 ${HOME}/.local/bin/myip}
${offset 15}Down:  ${downspeed wlan0}
${offset 15}Up:  ${upspeed wlan0}  
#${offset 15}${downspeedgraph wlan0 20,100} ${alignr}
#${upspeedgraph wlan0 20,100}${endif}  

${alignc}${font Ubuntu:bold:size=10}BATTERY STATUS ${font Ubuntu:bold:size=10}
${offset 10}Battery %: ${battery_short BAT0}
${offset 10}Charge Time Remaining: ${battery_time BAT0}   
]];
